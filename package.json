{
  "name": "portfolio-graphql-backend",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "A clean, interview-ready professional profile GraphQL API",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "start:prod:setup": "sh scripts/entrypoint.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/database/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:studio": "prisma studio",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=e2e-spec",
    "test:e2e": "jest --runInBand --testPathPattern=e2e-spec",
    "format": "prettier --write \"{src,prisma,test,scripts,docs}/**/*.{ts,js,md,sql,graphql}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{src,prisma,test,scripts,docs}/**/*.{ts,js,md,sql,graphql}\" \"*.{json,md,yml,yaml}\"",
    "check:profile": "sh scripts/check-personalization.sh"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.2.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/graphql": "14.2.0",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/client": "6.19.3",
    "dataloader": "2.2.3",
    "dotenv": "16.6.1",
    "graphql": "16.11.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/jest": "29.5.14",
    "@types/node": "22.15.30",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "prettier": "3.6.2",
    "supertest": "7.1.1",
    "ts-jest": "29.2.5",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
